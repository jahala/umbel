# no trailing slash: also ignores a stray `node_modules` *symlink* (a dir pattern
# does not, which let a build symlink get committed in #33 and broke CI on checkout)
node_modules
dist/
.umbel-state/
*.log
.DS_Store
.context/
.env
.env.local
*.tsbuildinfo
coverage/
docs/research/
# the brand is fetched by tag; only umbel's own product layer is kept
.brand/*
!.brand/products/
.brand/products/*
!.brand/products/umbel/
.loop-scratch/
