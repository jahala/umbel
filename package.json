{
  "name": "umbel",
  "version": "0.0.1",
  "description": "Remote-control interactive Claude Code (and other agent CLIs) over tmux. Subscription-billed orchestration.",
  "type": "module",
  "module": "src/main.ts",
  "bin": {
    "umbel": "./dist/umbel"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "install:bin": "bun run scripts/build.ts --install",
    "test": "bun test test/unit test/integration test/e2e",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:e2e": "bun test test/e2e",
    "test:smoke": "bun test ./test/smoke/claude/*.smoke.ts ./test/smoke/codex/*.smoke.ts ./test/smoke/gemini/*.smoke.ts",
    "test:smoke:claude": "bun test ./test/smoke/claude/*.smoke.ts",
    "test:smoke:codex": "bun test ./test/smoke/codex/*.smoke.ts",
    "test:smoke:gemini": "bun test ./test/smoke/gemini/*.smoke.ts",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^5.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
